@echo off
setlocal
set "BOT_FOTO_TARGET=%~dp0"
if not exist "%BOT_FOTO_TARGET%bot.py" goto cartella
if not exist "%BOT_FOTO_TARGET%FOTO\" goto cartella
if not exist "%BOT_FOTO_TARGET%DATI\" goto cartella
echo Scarico e verifico l'aggiornamento Beyond The Next __VERSION__...
powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand __ENCODED_COMMAND__
if errorlevel 1 goto errore
echo Aggiornamento completato. Avvio il bot...
call "%BOT_FOTO_TARGET%AVVIA.bat"
exit /b %errorlevel%
:cartella
echo Metti questo file nella cartella Bot-Foto che contiene bot.py, FOTO e DATI.
pause
exit /b 2
:errore
echo Aggiornamento non completato. La cartella Bot-Foto resta disponibile.
pause
exit /b 1
